{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidates",
    "source_state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "problem",
          "category",
          "subcategory",
          "language",
          "source_url",
          "source_repository",
          "author",
          "license",
          "license_url",
          "source_revision",
          "last_maintenance",
          "dependencies",
          "platforms",
          "permissions",
          "inputs",
          "outputs",
          "existing_tests",
          "limitations",
          "security_considerations",
          "discovered_on",
          "status",
          "reuse",
          "license_review",
          "security_review",
          "test_file",
          "test_evidence",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "subcategory": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_maintenance": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "string",
            "minLength": 1
          },
          "existing_tests": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "security_considerations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "discovered_on": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "discovered",
              "reviewed",
              "adapted",
              "tested",
              "accepted",
              "published",
              "rejected"
            ]
          },
          "reuse": {
            "enum": [
              "independent",
              "copied",
              "modified",
              "none"
            ]
          },
          "license_review": {
            "type": "string",
            "minLength": 1
          },
          "security_review": {
            "type": "string",
            "minLength": 1
          },
          "test_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "test_evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "attempts",
          "next_retry_at"
        ],
        "additionalProperties": false,
        "properties": {
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "next_retry_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
