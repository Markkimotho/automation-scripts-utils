{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Scripts Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scripts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "$defs": {
    "script": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "category",
        "topic",
        "language",
        "entrypoint",
        "platforms",
        "dependencies",
        "permissions",
        "destructive",
        "requires_confirmation",
        "supports_dry_run",
        "parameters",
        "tags",
        "expected_output",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 12
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "language": {
          "enum": [
            "python",
            "bash",
            "powershell",
            "javascript",
            "typescript",
            "go",
            "ruby"
          ]
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^scripts/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "linux",
              "macos",
              "windows"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "python_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "enum": [
              "filesystem-read",
              "filesystem-write",
              "network-read",
              "network-write",
              "cloud-read",
              "cloud-write",
              "system-read",
              "system-write"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "destructive": {
          "type": "boolean"
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "supports_dry_run": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              },
              "flag": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "choices": {
                "type": "array"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "expected_output": {
          "type": "string",
          "minLength": 5
        },
        "status": {
          "enum": [
            "existing",
            "maintained",
            "deprecated"
          ]
        }
      }
    }
  }
}
